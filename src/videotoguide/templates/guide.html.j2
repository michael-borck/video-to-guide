<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ guide.title }}</title>
<style>
  :root {
    --ink: #1a202c;
    --muted: #4a5568;
    --accent: #c53030;
    --border: #e2e8f0;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    line-height: 1.5;
  }
  h1 { font-size: 1.9rem; margin: 0 0 2rem; }
  h2 {
    font-size: 1.3rem;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--border);
  }
  .step {
    margin: 0 0 2rem;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .step-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .frame img { display: block; width: 100%; height: auto; }
  .ann-box {
    position: absolute;
    border: 3px solid var(--accent);
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.7) inset;
  }
  .ann-text {
    position: absolute;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink);
    white-space: nowrap;
  }
  .instruction { margin: 0.75rem 0 0; font-size: 1rem; }
  .instruction code {
    background: #edf2f7;
    border-radius: 3px;
    padding: 0.1em 0.35em;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.9em;
  }
  section { break-before: page; page-break-before: always; }
  section:first-of-type { break-before: auto; page-break-before: auto; }
  h2 { break-after: avoid; page-break-after: avoid; }
  @page { margin: 1.6cm; }
  @media print {
    body { max-width: none; padding: 0; }
    .frame { border-color: #cbd5e0; }
  }
</style>
</head>
<body>
<main>
  <h1>{{ guide.title }}</h1>
  {% for section in sections %}
  <section>
    <h2>{{ section.title }}</h2>
    {% for step in section.steps %}
    <article class="step">
      <div class="step-label">Step {{ step.number }}</div>
      <figure style="margin: 0;">
        <div class="frame" style="aspect-ratio: {{ step.width }} / {{ step.height }};">
          <img src="{{ step.frame_src }}" alt="Step {{ step.number }} screenshot">
          {% for a in step.overlays %}
          <div class="{{ a.cls }}" style="{{ a.style }}">{% if a.text %}{{ a.text }}{% endif %}</div>
          {% endfor %}
        </div>
        <figcaption class="instruction">{{ step.instruction_html }}</figcaption>
      </figure>
    </article>
    {% endfor %}
  </section>
  {% endfor %}
</main>
</body>
</html>
